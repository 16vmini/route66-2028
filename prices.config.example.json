{
  "_README": [
    "Copy this file to prices.config.json and paste your real keys.",
    "prices.config.json should NOT be shared/committed — it contains secrets.",
    "",
    "Two providers — use either or both:",
    "  rapidapi  → easy signup at https://rapidapi.com, subscribe to 'Booking COM 15' by DataCrawler (hotels + cars + maybe flights)",
    "  amadeus   → official airline-industry API at https://developers.amadeus.com (best for flights)",
    "",
    "Recommended: rapidapi for hotels + amadeus for flights. Skip a section if you don't want it."
  ],

  "provider": "rapidapi",
  "currency": "GBP",
  "adults": 2,

  "rapidapi": {
    "key": "PASTE_YOUR_X-RAPIDAPI-KEY_HERE",
    "_note": "From your RapidAPI dashboard. One key works for any subscriptions on your account."
  },

  "amadeus": {
    "apiKey": "PASTE_YOUR_AMADEUS_API_KEY_HERE",
    "apiSecret": "PASTE_YOUR_AMADEUS_API_SECRET_HERE",
    "environment": "test",
    "_note": "Test environment returns sample data. Click 'Go Production' in Amadeus dashboard for real prices, then change to 'production'."
  },

  "routes": {
    "outbound": [
      { "from": "LHR", "to": "ORD", "date": "2028-03-18" },
      { "from": "LGW", "to": "ORD", "date": "2028-03-18" }
